<% key = provider.fetch(:key) %>
<% reconnect_required = key == :github && github_connection&.sync_status_reauthorization_required? %>

<article class="provider-card provider-card--<%= provider.fetch(:tone) %>" aria-labelledby="provider-<%= key %>-heading">
  <div class="provider-card-heading">
    <div class="provider-card-identity">
      <span class="provider-icon" aria-hidden="true"><%= provider.fetch(:short_name) %></span>
      <div>
        <h2 id="provider-<%= key %>-heading"><%= provider.fetch(:name) %></h2>
        <p><%= provider.fetch(:purpose) %></p>
      </div>
    </div>

    <% if github_connection %>
      <span class="provider-status provider-status--<%= reconnect_required ? "reauthorization_required" : "ready" %>"><span aria-hidden="true"></span><%= reconnect_required ? "Reconnect" : "Connected" %></span>
    <% else %>
      <span class="provider-status provider-status--disconnected"><span aria-hidden="true"></span>Not connected</span>
    <% end %>
  </div>

  <% if github_connection %>
    <p class="provider-card-meta">Connected as <strong>@<%= github_identity.provider_username %></strong> · Tracking from <%= github_connection.tracking_started_on.to_fs(:long) %></p>
  <% else %>
    <p class="provider-card-meta">Tracking starts on the connection date. Earlier commits are not imported.</p>
    <div class="provider-card-actions">
      <%= button_to "Connect GitHub",
        "/auth/github",
        method: :post,
        form: { data: { turbo: false } },
        class: "button button--secondary provider-action" %>
    </div>
  <% end %>
</article>
