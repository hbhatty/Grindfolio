<article class="provider-card provider-card--blue" aria-labelledby="provider-leetcode-heading">
  <div class="provider-card-heading">
    <div class="provider-card-identity">
      <span class="provider-icon" aria-hidden="true">LC</span>
      <div>
        <h2 id="provider-leetcode-heading">LeetCode</h2>
        <p>Practice activity</p>
      </div>
    </div>

    <% if @leetcode_connection %>
      <span class="provider-status provider-status--ready"><span aria-hidden="true"></span>Connected</span>
    <% else %>
      <span class="provider-status provider-status--disconnected"><span aria-hidden="true"></span>Not connected</span>
    <% end %>
  </div>

  <% if @leetcode_connection %>
    <p class="provider-card-meta">
      <span class="provider-disclosure">Unsupported beta.</span>
      Connected as <strong>@<%= @leetcode_connection.username %></strong> · Tracking from
      <%= @leetcode_connection.tracking_started_on.to_fs(:long) %> (UTC)
    </p>
  <% else %>
    <p class="provider-card-meta">
      <span class="provider-disclosure">Unsupported beta.</span>
      <%= link_to "Connect from Account", account_path, class: "provider-card-link" %>.
      Tracking starts on the UTC connection date; earlier submissions are not imported.
    </p>
  <% end %>
</article>
