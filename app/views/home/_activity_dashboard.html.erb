<main
  class="dashboard-shell"
  data-controller="github-sync-refresh activity-panels"
  data-github-sync-refresh-url-value="<%= github_activity_update_path %>"
  data-github-sync-refresh-interval-value="2000"
  data-github-sync-refresh-max-attempts-value="30">
  <%= render "shared/authenticated_masthead",
    current_page: :activity,
    masthead_class: "dashboard-masthead",
    navigation_class: "dashboard-navigation" %>

  <header class="dashboard-heading">
    <div>
      <p class="dashboard-eyebrow">Private dashboard</p>
      <h1>Activity</h1>
      <p class="dashboard-intro">Your Build, Practice, and Apply record. Activity updates only when you ask.</p>
    </div>
    <div class="dashboard-heading-actions">
      <span class="dashboard-private-status"><span aria-hidden="true"></span>Private</span>
      <%= button_to "Update all",
        activity_update_path,
        method: :post,
        class: "button button--primary",
        disabled: !(@github_connection || @leetcode_connection || @notion_connection),
        data: { turbo_submits_with: "Updating…" } %>
    </div>
  </header>

  <div class="activity-selectors" aria-label="Activity heatmaps" data-activity-panels-target="list">
    <%= render "home/activity_selector",
      key: :build, label: "Build", provider: "GitHub", connection: @github_connection %>
    <%= render "home/activity_selector",
      key: :practice, label: "Practice", provider: "LeetCode", connection: @leetcode_connection %>
    <%= render "home/activity_selector",
      key: :apply, label: "Apply", provider: "Notion", connection: @notion_connection %>
  </div>

  <div id="build_activity_panel" class="activity-panel" data-activity-panels-target="panel" data-activity-key="build">
    <%= render "home/github_activity_frame" %>
  </div>
  <div id="practice_activity_panel" class="activity-panel" data-activity-panels-target="panel" data-activity-key="practice">
    <%= render "home/leetcode_activity" %>
  </div>
  <div id="apply_activity_panel" class="activity-panel" data-activity-panels-target="panel" data-activity-key="apply">
    <%= render "home/notion_activity" %>
  </div>
</main>
