<main
  class="dashboard-shell"
  data-controller="github-sync-refresh"
  data-github-sync-refresh-url-value="<%= github_activity_update_path %>"
  data-github-sync-refresh-interval-value="2000"
  data-github-sync-refresh-max-attempts-value="30">
  <header class="account-masthead dashboard-masthead">
    <%= link_to "Grindfolio", root_path, class: "auth-wordmark" %>

    <nav class="account-navigation dashboard-navigation" aria-label="Primary">
      <span aria-current="page">Activity</span>
      <%= link_to "Account", account_path %>
      <%= button_to "Sign out", sign_out_path, method: :delete, class: "dashboard-sign-out" %>
    </nav>
  </header>

  <header class="dashboard-heading">
    <div>
      <p class="dashboard-eyebrow">Private dashboard</p>
      <h1>Activity</h1>
      <p class="dashboard-intro">Your Build, Practice, and Apply record. Activity updates only when you ask.</p>
    </div>
    <span class="dashboard-private-status"><span aria-hidden="true"></span>Private</span>
  </header>

  <section class="provider-grid" aria-label="Activity providers">
    <%= render "home/github_provider_frame" %>
    <%= render "home/leetcode_provider_card" %>
    <%= render "home/notion_provider_card" %>
  </section>

  <%= render "home/github_activity_frame" %>
  <%= render "home/leetcode_activity" %>
  <%= render "home/notion_activity" %>
</main>
