<% content_for :title, "Please try again later" %>

<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="password-reset-request-rate-limit-heading">
    <%= link_to "Grindfolio", root_path, class: "auth-wordmark" %>

    <header class="auth-heading">
      <h1 id="password-reset-request-rate-limit-heading">Please try again later</h1>
      <div class="auth-copy">
        <p>We received several password-reset requests from this network. Please wait a few minutes before trying again.</p>
      </div>
    </header>

    <div class="auth-actions">
      <%= link_to "Try requesting another email", new_password_reset_request_path, class: "button button--primary" %>
    </div>
  </section>
</main>
