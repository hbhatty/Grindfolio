<% content_for :title, "GitHub connection was not completed" %>

<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="github-connection-failure-heading">
    <%= link_to "Grindfolio", root_path, class: "auth-wordmark" %>

    <header class="auth-heading">
      <h1 id="github-connection-failure-heading">GitHub connection was not completed</h1>
      <div class="auth-copy">
        <p>Grindfolio could not complete the GitHub authorization.</p>
        <p>No new GitHub connection or credentials were saved.</p>
      </div>
    </header>

    <div class="auth-actions">
      <%= link_to "Back to account", account_path, class: "button button--primary" %>
    </div>
  </section>
</main>
