<% tone = type.to_s == "alert" ? "alert" : "notice" %>
<% role = tone == "alert" ? "alert" : "status" %>
<div
  class="flash-message flash-message--<%= tone %>"
  role="<%= role %>"
  aria-atomic="true"
  data-controller="flash-message"
  data-turbo-temporary>
  <span class="flash-message__marker" aria-hidden="true"></span>
  <p class="flash-message__text"><%= message %></p>
  <button
    type="button"
    class="flash-message__dismiss"
    data-action="flash-message#dismiss">Dismiss</button>
</div>
