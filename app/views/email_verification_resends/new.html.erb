<% content_for :title, "Resend verification email" %>

<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="verification-resend-heading">
    <%= link_to "Grindfolio", root_path, class: "auth-wordmark" %>

    <header class="auth-heading">
      <h1 id="verification-resend-heading">Resend verification email</h1>
      <p class="auth-intro">Enter the email address you used to create your Grindfolio account.</p>
    </header>

    <%= form_with url: email_verification_resend_path, scope: :email_verification_resend, method: :post, class: "auth-form" do |form| %>
      <div class="form-field">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address,
          required: true,
          autocomplete: "email",
          maxlength: 254,
          size: nil,
          class: "form-control" %>
      </div>

      <%= form.submit "Send verification email", class: "button button--primary form-submit" %>
    <% end %>
  </section>
</main>
