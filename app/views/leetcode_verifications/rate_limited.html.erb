<% content_for :title, "LeetCode verification paused" %>

<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="rate-limit-heading">
    <%= link_to "Grindfolio", root_path, class: "auth-wordmark" %>

    <header class="auth-heading">
      <h1 id="rate-limit-heading">Wait before trying again</h1>
      <div class="auth-copy">
        <p>Too many LeetCode verification requests came from this network. No provider request was made.</p>
      </div>
    </header>

    <div class="auth-actions">
      <%= link_to "Return to your account", account_path, class: "button button--primary" %>
    </div>
  </section>
</main>
