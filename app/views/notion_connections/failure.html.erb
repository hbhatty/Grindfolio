<% content_for :title, "Notion connection unsuccessful" %>

<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="notion-connection-failure-heading">
    <%= link_to "Grindfolio", root_path, class: "auth-wordmark" %>

    <header class="auth-heading">
      <h1 id="notion-connection-failure-heading">Notion could not be connected</h1>
      <div class="auth-copy">
        <p>Grindfolio did not save a new Notion connection or replace existing credentials.</p>
      </div>
    </header>

    <div class="auth-actions">
      <%= link_to "Return to your account", account_path, class: "button button--primary" %>
    </div>
  </section>
</main>
