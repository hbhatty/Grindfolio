<% content_for :title, "Choose a new password" %>

<main class="auth-shell">
  <section class="auth-panel" aria-labelledby="password-reset-heading">
    <%= link_to "Grindfolio", root_path, class: "auth-wordmark" %>

    <header class="auth-heading">
      <h1 id="password-reset-heading">Choose a new password</h1>
      <p class="auth-intro">Your other Grindfolio sessions will be signed out after the password changes.</p>
    </header>

    <% if @password_credential.errors.any? %>
      <div class="form-message form-message--error" role="alert">
        <h2>Check the form</h2>
        <ul>
          <% @password_credential.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @password_credential, scope: :password_reset, url: password_reset_path(token: params[:token]), method: :patch, class: "auth-form" do |form| %>
      <div class="form-field">
        <%= form.label :password, "New password", class: "form-label" %>
        <%= form.password_field :password,
          value: nil,
          autocomplete: "new-password",
          required: true,
          minlength: PasswordCredential::PASSWORD_MINIMUM_LENGTH,
          maxlength: PasswordCredential::PASSWORD_MAXIMUM_BYTES,
          size: nil,
          autofocus: true,
          aria: { describedby: "reset-password-help" },
          class: "form-control" %>
        <small id="reset-password-help" class="form-help">Use at least 8 characters. Passwords must be no more than 72 bytes; some characters use more than one byte.</small>
      </div>

      <div class="form-field">
        <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
        <%= form.password_field :password_confirmation,
          value: nil,
          autocomplete: "new-password",
          required: true,
          minlength: PasswordCredential::PASSWORD_MINIMUM_LENGTH,
          maxlength: PasswordCredential::PASSWORD_MAXIMUM_BYTES,
          size: nil,
          class: "form-control" %>
      </div>

      <%= form.submit "Reset password", class: "button button--primary form-submit" %>
    <% end %>
  </section>
</main>
