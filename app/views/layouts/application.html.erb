<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Grindfolio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Grindfolio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_tag nonce: true do %>
      (() => {
        try {
          const theme = localStorage.getItem("grindfolio-theme")
          if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme
        } catch {}
      })()
    <% end %>


    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="theme-utility">
      <div
        class="theme-picker"
        data-controller="theme"
        data-action="click@window->theme#dismiss keydown.esc@window->theme#escape">
        <svg class="theme-picker__symbols" aria-hidden="true">
          <symbol id="theme-icon-system" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="14" rx="2"></rect>
            <path d="M8 21h8M12 18v3"></path>
          </symbol>
          <symbol id="theme-icon-light" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
          </symbol>
          <symbol id="theme-icon-dark" viewBox="0 0 24 24">
            <path d="M20.5 14.25A8.5 8.5 0 0 1 9.75 3.5a8.5 8.5 0 1 0 10.75 10.75Z"></path>
          </symbol>
          <symbol id="theme-icon-check" viewBox="0 0 24 24">
            <path d="m5 12 4 4L19 6"></path>
          </symbol>
        </svg>

        <button
          type="button"
          class="theme-picker__trigger"
          aria-label="Theme: System"
          aria-controls="theme-picker-menu"
          aria-expanded="false"
          aria-haspopup="menu"
          title="Theme: System"
          data-theme-target="trigger"
          data-action="theme#toggle keydown->theme#triggerKeydown">
          <svg class="theme-picker__current-icon theme-picker__current-icon--system" aria-hidden="true">
            <use href="#theme-icon-system"></use>
          </svg>
          <svg class="theme-picker__current-icon theme-picker__current-icon--light" aria-hidden="true">
            <use href="#theme-icon-light"></use>
          </svg>
          <svg class="theme-picker__current-icon theme-picker__current-icon--dark" aria-hidden="true">
            <use href="#theme-icon-dark"></use>
          </svg>
        </button>

        <div
          id="theme-picker-menu"
          class="theme-picker__menu"
          role="menu"
          aria-label="Theme"
          data-theme-target="menu"
          hidden>
          <% [["system", "System"], ["light", "Light"], ["dark", "Dark"]].each do |value, label| %>
            <button
              type="button"
              class="theme-picker__option"
              role="menuitemradio"
              aria-checked="<%= value == "system" %>"
              data-theme-value="<%= value %>"
              data-theme-target="option"
              data-action="theme#choose keydown->theme#optionKeydown">
              <svg class="theme-picker__option-icon" aria-hidden="true">
                <use href="#theme-icon-<%= value %>"></use>
              </svg>
              <span><%= label %></span>
              <svg class="theme-picker__check" aria-hidden="true">
                <use href="#theme-icon-check"></use>
              </svg>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <% if flash.any? %>
      <div class="flash-stack" data-turbo-temporary>
        <% flash.each do |type, message| %>
          <% tone = type.to_s == "alert" ? "alert" : "notice" %>
          <% role = tone == "alert" ? "alert" : "status" %>
          <div
            class="flash-message flash-message--<%= tone %>"
            role="<%= role %>"
            aria-atomic="true"
            data-controller="flash-message">
            <span class="flash-message__marker" aria-hidden="true"></span>
            <p class="flash-message__text"><%= message %></p>
            <button
              type="button"
              class="flash-message__dismiss"
              data-action="flash-message#dismiss">Dismiss</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
