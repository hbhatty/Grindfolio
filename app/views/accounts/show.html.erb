<% content_for :title, "Your Grindfolio account" %>

<main class="account-shell">
  <header class="account-header">
    <div>
      <p class="account-eyebrow">Settings</p>
      <h1>Your Grindfolio account</h1>
      <p class="account-intro">Manage your account details and the providers connected to your private activity dashboard.</p>
    </div>
    <%= link_to "Back to activity", root_path, class: "account-back-link" %>
  </header>

  <div class="account-layout">
    <section class="account-card" aria-labelledby="account-details-heading">
      <div class="account-card-heading">
        <div>
          <p class="account-section-label">Profile</p>
          <h2 id="account-details-heading">Account details</h2>
        </div>
        <span class="account-lock" aria-hidden="true">Private</span>
      </div>

      <% if @verified_email_address %>
        <dl class="account-info">
          <div>
            <dt>Verified email address</dt>
            <dd><%= @verified_email_address %></dd>
            <span class="account-badge">Verified</span>
          </div>
        </dl>
      <% end %>

      <% if @user.errors.any? %>
        <div class="account-errors" role="alert">
          <h3>Check the form</h3>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="account-form-heading">
        <h3>Calendar settings</h3>
        <p>Your time zone is used when Grindfolio displays local calendar dates.</p>
      </div>

      <%= form_with model: @user, url: account_path, method: :patch, class: "account-form" do |form| %>
        <div>
          <%= form.label :time_zone, "Time zone" %>
          <%= form.select :time_zone,
            options_for_select(User::IANA_TIME_ZONE_IDENTIFIERS, @user.time_zone),
            { include_blank: "Select your time zone" },
            required: true,
            aria: { describedby: "time-zone-help" } %>
          <small id="time-zone-help">Choose an IANA time zone, such as America/Toronto.</small>
        </div>

        <%= form.submit "Save time zone" %>
      <% end %>
    </section>

    <section class="account-card account-card--connections" aria-labelledby="provider-connections-heading">
      <div class="account-card-heading">
        <div>
          <p class="account-section-label">Data sources</p>
          <h2 id="provider-connections-heading">Provider connections</h2>
        </div>
      </div>
      <p class="account-card-intro">Connect the accounts Grindfolio uses for your private activity dashboard.</p>

      <div class="account-provider-list">
        <article class="account-provider account-provider--github">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">GH</span>
              <div>
                <h3>GitHub</h3>
                <p>Build activity</p>
              </div>
            </div>
            <% if @github_connection %>
              <% github_status_label = case @github_connection.sync_status
              when "queued", "syncing" then "Updating"
              when "reauthorization_required" then "Reconnect"
              when "error" then "Update failed"
              when "ready" then "Updated"
              else "Not updated"
              end %>
              <span class="account-provider-status account-provider-status--<%= @github_connection.sync_status %>"><span aria-hidden="true"></span><%= github_status_label %></span>
            <% else %>
              <span class="account-provider-status account-provider-status--available">Available</span>
            <% end %>
          </div>

          <% if @github_connection %>
            <dl class="account-connection-info">
              <div>
                <dt>Connected account</dt>
                <dd><%= @github_identity.provider_username %></dd>
              </div>
              <div>
                <dt>Tracking started</dt>
                <dd><%= @github_connection.tracking_started_on.to_fs(:long) %></dd>
              </div>
            </dl>
            <%= button_to "Reauthorize GitHub",
              "/auth/github",
              method: :post,
              form: { data: { turbo: false } },
              class: "account-provider-action" %>
            <p class="account-provider-help">Reauthorizing updates secure credentials without resetting your tracking date.</p>
          <% else %>
            <p class="account-provider-help">Connecting proves account ownership and starts tracking from the connection date.</p>
            <%= button_to "Connect GitHub",
              "/auth/github",
              method: :post,
              form: { data: { turbo: false } },
              class: "account-provider-action" %>
          <% end %>
        </article>

        <article class="account-provider account-provider--leetcode">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">LC</span>
              <div>
                <h3>LeetCode</h3>
                <p>Practice activity</p>
              </div>
            </div>
            <% if @leetcode_connection %>
              <span class="account-provider-status account-provider-status--ready"><span aria-hidden="true"></span>Connected</span>
            <% elsif @leetcode_challenge&.usable? %>
              <span class="account-provider-status account-provider-status--pending"><span aria-hidden="true"></span>Verification pending</span>
            <% elsif @leetcode_challenge %>
              <span class="account-provider-status account-provider-status--error"><span aria-hidden="true"></span>Challenge expired</span>
            <% else %>
              <span class="account-provider-status account-provider-status--pending"><span aria-hidden="true"></span>Unsupported beta</span>
            <% end %>
          </div>

          <p class="account-provider-warning"><strong>Unsupported beta.</strong> LeetCode does not provide a documented API or stability guarantee for this connection.</p>

          <% if @leetcode_connection %>
            <dl class="account-connection-info">
              <div>
                <dt>Connected account</dt>
                <dd><%= @leetcode_connection.username %></dd>
              </div>
              <div>
                <dt>Tracking started</dt>
                <dd><%= @leetcode_connection.tracking_started_on.to_fs(:long) %> UTC</dd>
              </div>
            </dl>
            <p class="account-provider-help">Ownership is verified. Activity synchronization is not part of this checkpoint yet.</p>
          <% else %>
            <% if @leetcode_challenge&.usable? %>
              <div class="account-challenge" aria-labelledby="leetcode-challenge-heading">
                <h4 id="leetcode-challenge-heading">Verify <%= @leetcode_challenge.requested_username %></h4>
                <p>Add this exact temporary challenge to your public LeetCode README/About Me:</p>
                <code class="account-challenge-code"><%= @leetcode_challenge.token %></code>
                <ol>
                  <li>Copy the challenge into your LeetCode README/About Me and save.</li>
                  <li>Return here and verify before it expires.</li>
                  <li>Remove the challenge after Grindfolio confirms the connection.</li>
                </ol>
                <%= button_to "Verify LeetCode account",
                  verify_leetcode_verification_path,
                  method: :post,
                  class: "account-provider-action" %>
              </div>
            <% elsif @leetcode_challenge %>
              <p class="account-provider-help">That challenge expired. Generate a new one before editing your LeetCode profile.</p>
            <% else %>
              <p class="account-provider-help">Enter your public username. Generating a challenge makes no LeetCode request.</p>
            <% end %>

            <%= form_with url: leetcode_verification_path,
              scope: :leetcode_verification,
              method: :post,
              class: "account-provider-form" do |form| %>
              <%= form.label :username, "LeetCode username" %>
              <%= form.text_field :username,
                value: @leetcode_challenge&.requested_username,
                required: true,
                maxlength: 64,
                autocomplete: "off",
                spellcheck: false,
                aria: { describedby: "leetcode-username-help" } %>
              <small id="leetcode-username-help">Use the username from your public LeetCode profile, not a profile URL.</small>
              <%= form.submit @leetcode_challenge&.usable? ? "Generate a new challenge" : "Start LeetCode verification",
                class: "account-provider-action" %>
            <% end %>
          <% end %>
        </article>

        <article class="account-provider">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">N</span>
              <div>
                <h3>Notion</h3>
                <p>Job application activity</p>
              </div>
            </div>
            <% if @notion_connection %>
              <span class="account-provider-status account-provider-status--ready"><span aria-hidden="true"></span>Connected</span>
            <% else %>
              <span class="account-provider-status account-provider-status--available">Available</span>
            <% end %>
          </div>

          <% if @notion_connection %>
            <dl class="account-connection-info">
              <div>
                <dt>Workspace</dt>
                <dd><%= @notion_connection.workspace_name.presence || "Notion workspace" %></dd>
              </div>
              <div>
                <dt>Tracking started</dt>
                <dd><%= @notion_connection.tracking_started_on.to_fs(:long) %></dd>
              </div>
            </dl>
            <%= button_to "Reauthorize Notion",
              notion_authorization_path,
              method: :post,
              form: { data: { turbo: false } },
              class: "account-provider-action" %>
            <p class="account-provider-help">Reauthorizing updates secure credentials without resetting your tracking date. Application synchronization remains unavailable until a tracker is configured.</p>
          <% else %>
            <p class="account-provider-help">Authorize read-only access and choose which Notion pages Grindfolio may access. Connecting does not synchronize application activity.</p>
            <%= button_to "Connect Notion",
              notion_authorization_path,
              method: :post,
              form: { data: { turbo: false } },
              class: "account-provider-action" %>
          <% end %>
        </article>
      </div>
    </section>
  </div>

  <p class="account-privacy-note">Your account and activity are private. Public profiles and sharing are not available yet.</p>
</main>
