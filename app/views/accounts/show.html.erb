<% content_for :title, "Your Gridfolio account" %>

<main class="account-shell">
  <header class="account-header">
    <div>
      <p class="account-eyebrow">Settings</p>
      <h1>Your Gridfolio account</h1>
      <p class="account-intro">Manage your account details and the providers connected to your private activity dashboard.</p>
    </div>
    <%= link_to "Back to activity", root_path, class: "account-back-link" %>
  </header>

  <div class="account-layout">
    <section class="account-card" aria-labelledby="account-details-heading">
      <div class="account-card-heading">
        <div>
          <p class="account-section-label">Profile</p>
          <h2 id="account-details-heading">Account details</h2>
        </div>
        <span class="account-lock" aria-hidden="true">Private</span>
      </div>

      <% if @verified_email_address %>
        <dl class="account-info">
          <div>
            <dt>Verified email address</dt>
            <dd><%= @verified_email_address %></dd>
            <span class="account-badge">Verified</span>
          </div>
        </dl>
      <% end %>

      <% if @user.errors.any? %>
        <div class="account-errors" role="alert">
          <h3>Check the form</h3>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="account-form-heading">
        <h3>Calendar settings</h3>
        <p>Your time zone is used when Gridfolio displays local calendar dates.</p>
      </div>

      <%= form_with model: @user, url: account_path, method: :patch, class: "account-form" do |form| %>
        <div>
          <%= form.label :time_zone, "Time zone" %>
          <%= form.select :time_zone,
            options_for_select(User::IANA_TIME_ZONE_IDENTIFIERS, @user.time_zone),
            { include_blank: "Select your time zone" },
            required: true,
            aria: { describedby: "time-zone-help" } %>
          <small id="time-zone-help">Choose an IANA time zone, such as America/Toronto.</small>
        </div>

        <%= form.submit "Save time zone" %>
      <% end %>
    </section>

    <section class="account-card account-card--connections" aria-labelledby="provider-connections-heading">
      <div class="account-card-heading">
        <div>
          <p class="account-section-label">Data sources</p>
          <h2 id="provider-connections-heading">Provider connections</h2>
        </div>
      </div>
      <p class="account-card-intro">Connect the accounts Gridfolio uses for your private activity dashboard.</p>

      <div class="account-provider-list">
        <article class="account-provider account-provider--github">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">GH</span>
              <div>
                <h3>GitHub</h3>
                <p>Build activity</p>
              </div>
            </div>
            <% if @github_connection %>
              <% github_status_label = case @github_connection.sync_status
              when "queued", "syncing" then "Updating"
              when "reauthorization_required" then "Reconnect"
              when "error" then "Update failed"
              when "ready" then "Updated"
              else "Not updated"
              end %>
              <span class="account-provider-status account-provider-status--<%= @github_connection.sync_status %>"><span aria-hidden="true"></span><%= github_status_label %></span>
            <% else %>
              <span class="account-provider-status account-provider-status--available">Available</span>
            <% end %>
          </div>

          <% if @github_connection %>
            <dl class="account-connection-info">
              <div>
                <dt>Connected account</dt>
                <dd><%= @github_identity.provider_username %></dd>
              </div>
              <div>
                <dt>Tracking started</dt>
                <dd><%= @github_connection.tracking_started_on.to_fs(:long) %></dd>
              </div>
            </dl>
            <%= button_to "Reauthorize GitHub",
              "/auth/github",
              method: :post,
              form: { data: { turbo: false } },
              class: "account-provider-action" %>
            <p class="account-provider-help">Reauthorizing updates secure credentials without resetting your tracking date.</p>
          <% else %>
            <p class="account-provider-help">Connecting proves account ownership and starts tracking from the connection date.</p>
            <%= button_to "Connect GitHub",
              "/auth/github",
              method: :post,
              form: { data: { turbo: false } },
              class: "account-provider-action" %>
          <% end %>
        </article>

        <article class="account-provider account-provider--disabled">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">LC</span>
              <div>
                <h3>LeetCode</h3>
                <p>Practice activity</p>
              </div>
            </div>
            <span class="account-provider-status">Coming soon</span>
          </div>
          <p class="account-provider-help">Daily submission tracking will be available after the LeetCode integration is validated.</p>
          <button type="button" disabled>Connect LeetCode — Coming soon</button>
        </article>

        <article class="account-provider account-provider--disabled">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">N</span>
              <div>
                <h3>Notion</h3>
                <p>Job application activity</p>
              </div>
            </div>
            <span class="account-provider-status">Coming soon</span>
          </div>
          <p class="account-provider-help">Choose and map an applications database when the Notion integration is ready.</p>
          <button type="button" disabled>Connect Notion — Coming soon</button>
        </article>
      </div>
    </section>
  </div>

  <p class="account-privacy-note">Your account and activity are private. Public profiles and sharing are not available yet.</p>
</main>
