<% content_for :title, "Your Grindfolio account" %>

<main class="account-shell">
  <%= render "shared/authenticated_masthead", current_page: :account %>

  <header class="account-heading">
    <div>
      <p class="account-eyebrow">Settings</p>
      <h1>Your Grindfolio account</h1>
      <p class="account-intro">Manage your account details and the providers connected to your private activity dashboard.</p>
    </div>
    <span class="account-private-status"><span aria-hidden="true"></span>Private</span>
  </header>

  <div class="account-layout">
    <section class="account-panel" aria-labelledby="account-details-heading">
      <div class="account-panel-heading">
        <div>
          <p class="account-section-label">Account</p>
          <h2 id="account-details-heading">Details and preferences</h2>
        </div>
      </div>

      <div class="account-settings">
        <% if @verified_email_address %>
          <div class="account-setting">
            <h3>Email address</h3>
            <div class="account-email-details">
              <dl class="account-info">
                <div>
                  <dt>Verified email address</dt>
                  <dd><%= @verified_email_address %></dd>
                </div>
              </dl>
              <span class="account-badge">Verified</span>
            </div>
          </div>
        <% end %>

        <div class="account-setting">
          <h3>Calendar settings</h3>
          <p class="account-setting-description">Your time zone is used for local calendar dates and new tracking boundaries.</p>

          <% if @user.errors.any? %>
            <div class="form-message form-message--error" role="alert">
              <p><strong>Check the form</strong></p>
              <ul>
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with model: @user, url: account_path, method: :patch, class: "account-form" do |form| %>
            <div class="form-field">
              <%= form.label :time_zone, "Time zone", class: "form-label" %>
              <%= form.select :time_zone,
                options_for_select(User::IANA_TIME_ZONE_IDENTIFIERS, @user.time_zone),
                { include_blank: "Select your time zone" },
                required: true,
                aria: { describedby: "time-zone-help" },
                class: "form-control" %>
              <small id="time-zone-help" class="form-help">Choose an IANA time zone, such as America/Toronto.</small>
            </div>

            <%= form.submit "Save time zone", class: "button button--primary" %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="account-panel" aria-labelledby="provider-connections-heading">
      <div class="account-panel-heading">
        <div>
          <p class="account-section-label">Connections</p>
          <h2 id="provider-connections-heading">Provider connections</h2>
          <p class="account-panel-intro">Manage the accounts Grindfolio uses for Build, Practice, and Apply activity.</p>
        </div>
      </div>

      <div class="account-provider-list">
        <article class="account-provider" aria-labelledby="github-connection-heading">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">GH</span>
              <div>
                <h3 id="github-connection-heading">GitHub</h3>
                <p>Build activity</p>
              </div>
            </div>

            <% if @github_connection %>
              <% reconnect_required = @github_connection.sync_status_reauthorization_required? %>
              <span class="account-provider-status account-provider-status--<%= reconnect_required ? "reauthorization_required" : "ready" %>"><span aria-hidden="true"></span><%= reconnect_required ? "Reconnect" : "Connected" %></span>
            <% else %>
              <span class="account-provider-status account-provider-status--available"><span aria-hidden="true"></span>Not connected</span>
            <% end %>
          </div>

          <% if @github_connection %>
            <dl class="account-connection-info">
              <div>
                <dt>Connected account</dt>
                <dd><%= @github_identity.provider_username %></dd>
              </div>
              <div>
                <dt>Tracking started</dt>
                <dd><%= @github_connection.tracking_started_on.to_fs(:long) %></dd>
              </div>
            </dl>
            <p class="account-provider-copy">Update Build activity from your dashboard. Reauthorizing refreshes secure credentials without resetting your tracking date.</p>
            <div class="account-provider-actions">
              <%= button_to "Reauthorize GitHub",
                "/auth/github",
                method: :post,
                form: { data: { turbo: false } },
                class: "button button--secondary" %>
            </div>
          <% else %>
            <p class="account-provider-copy">Connect the GitHub account you control to begin forward-only Build tracking. Activity updates remain a dashboard action.</p>
            <div class="account-provider-actions">
              <%= button_to "Connect GitHub",
                "/auth/github",
                method: :post,
                form: { data: { turbo: false } },
                class: "button button--secondary" %>
            </div>
          <% end %>
        </article>

        <article class="account-provider account-provider--leetcode" aria-labelledby="leetcode-connection-heading">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">LC</span>
              <div>
                <h3 id="leetcode-connection-heading">LeetCode</h3>
                <p>Practice activity</p>
              </div>
            </div>

            <% if @leetcode_connection %>
              <span class="account-provider-status account-provider-status--ready"><span aria-hidden="true"></span>Connected</span>
            <% elsif @leetcode_challenge&.usable? %>
              <span class="account-provider-status account-provider-status--pending"><span aria-hidden="true"></span>Verification pending</span>
            <% elsif @leetcode_challenge %>
              <span class="account-provider-status account-provider-status--error"><span aria-hidden="true"></span>Challenge expired</span>
            <% else %>
              <span class="account-provider-status account-provider-status--pending"><span aria-hidden="true"></span>Unofficial beta</span>
            <% end %>
          </div>

          <p class="account-provider-warning"><strong>Unofficial integration.</strong> This experimental connection uses an undocumented public LeetCode interface and is not affiliated with or endorsed by LeetCode. It may change or become unavailable; use it at your discretion.</p>

          <% if @leetcode_connection %>
            <dl class="account-connection-info">
              <div>
                <dt>Connected account</dt>
                <dd><%= @leetcode_connection.username %></dd>
              </div>
              <div>
                <dt>Tracking started</dt>
                <dd><%= @leetcode_connection.tracking_started_on.to_fs(:long) %> UTC</dd>
              </div>
            </dl>
            <p class="account-provider-copy">Update current-year Practice activity manually from your dashboard. LeetCode dates remain in UTC.</p>
          <% else %>
            <% if @leetcode_challenge&.usable? %>
              <div class="account-challenge" aria-labelledby="leetcode-challenge-heading">
                <h4 id="leetcode-challenge-heading">Verify <%= @leetcode_challenge.requested_username %></h4>
                <p>Add this exact temporary challenge to your public LeetCode About Me field:</p>
                <code class="account-challenge-code"><%= @leetcode_challenge.token %></code>
                <ol>
                  <li>Copy the challenge into your LeetCode About Me field and save.</li>
                  <li>Return here and verify before it expires.</li>
                  <li>Remove the challenge after Grindfolio confirms the connection.</li>
                </ol>
                <div class="account-provider-actions">
                  <%= button_to "Verify LeetCode account",
                    verify_leetcode_verification_path,
                    method: :post,
                    class: "button button--primary" %>
                </div>
              </div>
            <% elsif @leetcode_challenge %>
              <p class="account-provider-copy account-provider-copy--error">That challenge expired. Generate a new one before editing your LeetCode profile.</p>
            <% else %>
              <p class="account-provider-copy">Enter your public username. Generating a challenge makes no LeetCode request.</p>
            <% end %>

            <%= form_with url: leetcode_verification_path,
              scope: :leetcode_verification,
              method: :post,
              class: "account-provider-form" do |form| %>
              <div class="form-field">
                <%= form.label :username, "LeetCode username", class: "form-label" %>
                <%= form.text_field :username,
                  value: @leetcode_challenge&.requested_username,
                  required: true,
                  maxlength: 64,
                  autocomplete: "off",
                  spellcheck: false,
                  aria: { describedby: "leetcode-username-help" },
                  class: "form-control" %>
                <small id="leetcode-username-help" class="form-help">Use the username from your public LeetCode profile, not a profile URL.</small>
              </div>
              <%= form.submit @leetcode_challenge&.usable? ? "Generate a new challenge" : "Start LeetCode verification",
                class: "button #{@leetcode_challenge&.usable? ? "button--secondary" : "button--primary"}" %>
            <% end %>
          <% end %>
        </article>

        <article class="account-provider" aria-labelledby="notion-connection-heading">
          <div class="account-provider-topline">
            <div class="account-provider-identity">
              <span class="account-provider-icon" aria-hidden="true">N</span>
              <div>
                <h3 id="notion-connection-heading">Notion</h3>
                <p>Job application activity</p>
              </div>
            </div>

            <% if @notion_connection %>
              <span class="account-provider-status account-provider-status--ready"><span aria-hidden="true"></span>Connected</span>
            <% else %>
              <span class="account-provider-status account-provider-status--available"><span aria-hidden="true"></span>Not connected</span>
            <% end %>
          </div>

          <% if @notion_connection %>
            <dl class="account-connection-info">
              <div>
                <dt>Workspace</dt>
                <dd><%= @notion_connection.workspace_name.presence || "Notion workspace" %></dd>
              </div>
              <div>
                <dt>Tracking started</dt>
                <dd><%= @notion_connection.tracking_started_on.to_fs(:long) %></dd>
              </div>
            </dl>
            <p class="account-provider-copy">Synchronize applications from the supported tracker template manually from your dashboard. Reauthorizing refreshes secure credentials without resetting your tracking date.</p>
            <div class="account-provider-actions">
              <%= button_to "Reauthorize Notion",
                notion_authorization_path,
                method: :post,
                form: { data: { turbo: false } },
                class: "button button--secondary" %>
            </div>
          <% else %>
            <p class="account-provider-copy">Authorize a Notion workspace and select the supported applications tracker template. Synchronization begins only when you choose Update activity on your dashboard.</p>
            <div class="account-provider-actions">
              <%= button_to "Connect Notion",
                notion_authorization_path,
                method: :post,
                form: { data: { turbo: false } },
                class: "button button--secondary" %>
            </div>
          <% end %>
        </article>
      </div>
    </section>
  </div>

  <p class="account-privacy-note">Your account and activity are private. Public profiles and sharing are not available yet.</p>
</main>
